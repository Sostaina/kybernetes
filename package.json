{
  "name": "kybernetes",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.1",
  "engines": { "node": ">=20" },
  "description": "Plantilla de disciplina para colaboración humano-máquina. Monorepo de sistemas viables con fronteras.",
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint:boundaries": "depcruise --config .dependency-cruiser.cjs packages",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.9",
    "@types/node": "^20.19.43",
    "dependency-cruiser": "^16.4.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3",
    "vitest": "^4.1.10"
  }
}
